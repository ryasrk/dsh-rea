{
  "name": "dsh-plugin-rea",
  "version": "1.0.0",
  "description": "Reverse engineer anything with REA v6.8.0: native binaries, JavaScript/Electron apps, .NET, Android APKs, network captures, and agent RL environments.",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "engines": {
    "dsh": "*"
  },
  "keywords": [
    "reverse-engineering",
    "rea",
    "binary-analysis",
    "ghidra",
    "ida",
    "radare2",
    "frida",
    "ghidra-scripts",
    "malware-analysis",
    "decompilation",
    "nsis",
    "pyinstaller",
    "electron",
    "apk"
  ],
  "author": "ryasrk",
  "homepage": "https://github.com/ryasrk/dsh-rea",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryasrk/dsh-rea"
  }
}
